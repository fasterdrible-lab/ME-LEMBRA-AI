# Normalize line endings in the repository
* text=auto

# Force LF for source and config files
*.dart         text eol=lf
*.md           text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.gradle       text eol=lf
*.kts          text eol=lf
*.swift        text eol=lf
*.c            text eol=lf
*.cc           text eol=lf
*.cpp          text eol=lf
*.h            text eol=lf
*.cmake        text eol=lf
*.txt          text eol=lf

# Binary assets (never modify)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.zip          binary
*.apk          binary
