<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <!-- Cabecalho roxo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#7B5EA7"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Me Lembra Ai"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wgt_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFFB3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Corpo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:background="#FFFFFF">

        <!-- Linha 1 -->
        <LinearLayout
            android:id="@+id/wgt_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/wgt_dot1"
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:text="&#9679;"
                android:textColor="#7B5EA7"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/wgt_title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text=""
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wgt_time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Linha 2 -->
        <LinearLayout
            android:id="@+id/wgt_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/wgt_dot2"
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:text="&#9679;"
                android:textColor="#7B5EA7"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/wgt_title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text=""
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wgt_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Linha 3 -->
        <LinearLayout
            android:id="@+id/wgt_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/wgt_dot3"
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:text="&#9679;"
                android:textColor="#7B5EA7"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/wgt_title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text=""
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wgt_time3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- +N mais -->
        <TextView
            android:id="@+id/wgt_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#7B5EA7"
            android:textSize="11sp"
            android:gravity="end"
            android:visibility="gone" />

        <!-- Estado vazio -->
        <TextView
            android:id="@+id/wgt_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Nenhum lembrete hoje"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="visible" />

    </LinearLayout>
</LinearLayout>
