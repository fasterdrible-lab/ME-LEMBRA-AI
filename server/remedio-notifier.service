[Unit]
Description=Me Lembra Ai — Aviso a familia de remedio nao confirmado
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sos_notifier
ExecStart=/root/sos_notifier/venv/bin/python3 /root/sos_notifier/remedio_notifier.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
