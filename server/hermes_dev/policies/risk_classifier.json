{
  "description": "Classificação de risco por arquivo/área tocada (TAREFA 5). Um bug pode tocar múltiplos arquivos — o risco final é o MAIOR risco entre todos os arquivos alterados. Qualquer arquivo em protected_files.json força no mínimo HIGH. Qualquer arquivo/trecho batendo em critical_patterns força CRITICAL, mesmo que não esteja na lista explícita.",
  "levels": {
    "LOW": {
      "examples": ["UI", "texto", "layout", "cor", "ícone"],
      "path_patterns": [
        "lib/**/*_screen.dart (mudanças puramente visuais: texto, cor, espaçamento, ícone)",
        "assets/**",
        "android/app/src/main/res/values/strings.xml",
        "android/app/src/main/res/layout/*.xml"
      ]
    },
    "MEDIUM": {
      "examples": ["ReminderService", "navegação", "notificações normais", "validações"],
      "path_patterns": [
        "lib/services/reminder_service.dart",
        "lib/services/vehicle_service.dart",
        "lib/services/family_service.dart",
        "lib/services/chat_service.dart",
        "lib/services/widget_service.dart",
        "lib/services/profile_service.dart",
        "lib/services/settings_service.dart",
        "lib/services/smart_suggestions_service.dart",
        "lib/features/**",
        "lib/models/**"
      ]
    },
    "HIGH": {
      "examples": ["Firebase", "Auth", "Firestore Rules", "Android nativo", "FCM"],
      "path_patterns": [
        "lib/firebase_options.dart",
        "lib/services/fcm_service.dart",
        "firestore.rules",
        "firestore.indexes.json",
        "android/**",
        "server/ai_command_server/**",
        "server/sos_notifier.py"
      ],
      "requires": ["DeveloperAgent", "ReviewerAgent", "testes específicos", "aprovação humana antes de PR/merge"]
    },
    "CRITICAL": {
      "examples": ["SOS", "FallDetectorService", "ligação automática", "serviços de emergência", "permissões críticas"],
      "path_patterns": [
        "lib/services/sos_service.dart",
        "lib/services/fall_detector_service.dart",
        "lib/services/sos_listener_service.dart",
        "lib/services/sos_protection_service.dart",
        "lib/services/volume_sos_service.dart",
        "lib/services/location_service.dart",
        "android/app/src/main/kotlin/**/MainActivity.kt",
        "android/app/src/main/kotlin/**/SosProtectionService.kt"
      ],
      "critical_keywords_in_diff": ["sos", "queda", "fall", "emergenc", "call", "telecom", "trigger", "socorro"],
      "requires": ["DeveloperAgent", "ReviewerAgent", "testes dedicados", "relatório de risco", "aprovação humana ANTES de aplicar a correção, não só antes do merge (TAREFA 13)"]
    }
  }
}
