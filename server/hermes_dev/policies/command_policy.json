{
  "description": "Política de comandos (TAREFA 15). 'blocked' também está espelhado em .claude/settings.json (permissions.deny) para ser bloqueado pelo próprio harness, não só por convenção documental.",
  "allowed_auto": [
    "git status", "git diff", "git log", "git branch", "git worktree list",
    "flutter analyze", "flutter test", "flutter test *", "flutter pub get", "dart format *"
  ],
  "requires_approval": [
    "flutter pub upgrade", "git push *", "git merge *", "firebase deploy *",
    "systemctl restart *", "docker restart *", "gh pr create *"
  ],
  "blocked": [
    "rm -rf *", "git reset --hard *", "git clean -fd *", "git clean -fdx *",
    "firebase firestore:delete *", "DROP DATABASE *", "DELETE * (sem filtro/WHERE)",
    "git push --force * main", "git branch -D main"
  ]
}
