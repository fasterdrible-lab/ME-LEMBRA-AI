# Copie para .env (nunca commitar o .env de verdade) e preencha com a chave
# nova gerada no console da Groq (https://console.groq.com/keys).
GROQ_API_KEY=coloque_sua_chave_groq_aqui

# Opcional - troque se quiser usar outro modelo da Groq. A Groq descontinua
# modelos de tempos em tempos (aconteceu com llama-3.3-70b-versatile em
# ago/2026) — se voltar a dar 404 "model_not_found", confira os modelos
# disponíveis em https://console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-20b
# Reservas da Groq, tentados em ordem depois do principal (limite POR MODELO).
GROQ_MODELOS_RESERVA=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Opcional (TAREFA 32) - DeepSeek, pago e barato, usado SÓ quando todos os
# modelos da Groq falharem. Sem esta linha ele não entra. Chave em
# https://platform.deepseek.com/api_keys (precisa de saldo na conta).
# DEEPSEEK_API_KEY=coloque_sua_chave_deepseek_aqui
# DEEPSEEK_MODEL=deepseek-chat
