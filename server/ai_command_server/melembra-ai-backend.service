[Unit]
Description=Me Lembra Ai — Backend de comando de voz por IA (Groq)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai_command_server
EnvironmentFile=/root/ai_command_server/.env
ExecStart=/root/ai_command_server/venv/bin/gunicorn -w 2 -b 127.0.0.1:8091 app:app
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
