[Unit]
Description=Me Lembra Ai — SOS Push Notifier
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sos_notifier
ExecStart=/root/sos_notifier/venv/bin/python3 /root/sos_notifier/sos_notifier.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
